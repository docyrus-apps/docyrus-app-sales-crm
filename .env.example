VITE_API_BASE_URL=https://localhost:3366
VITE_OAUTH2_CLIENT_ID=your-client-id
VITE_OAUTH2_REDIRECT_PATH=/auth/callback
VITE_OAUTH2_SCOPES=openid profile offline_access User.Read DS.ReadWrite.All
VITE_ALLOWED_HOST_ORIGINS=http://localhost:5173

# Tenant storage, used by the data-import wizard. The import API downloads the
# uploaded file from tenant storage and serves no upload route of its own, so
# the app writes it there first (src/lib/import-file-upload.ts). Both values are
# the same ones the Docyrus shell ships in its own bundle — the anon key is a
# public client key, not a secret. Leave them unset and the Import buttons stay
# hidden instead of starting a run that cannot finish.
VITE_SUPABASE_URL=https://api.docyrus.app
VITE_SUPABASE_ANON_KEY=your-anon-key
